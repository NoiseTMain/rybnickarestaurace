{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "lhr1"
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/weekly",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 17 * * *"
    }
  ]
}
