# =====================================================================
# Restaurace Rybníky – proměnné prostředí
# Zkopírujte do .env.local (lokálně) nebo nastavte ve Vercel → Settings → Environment Variables.
# Proměnné s prefixem NEXT_PUBLIC_ jsou veřejné (dostanou se do prohlížeče).
# Ostatní jsou TAJNÉ – nikdy je nevkládejte do kódu ani do veřejného repozitáře.
# =====================================================================

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# veřejný „anon“ / „publishable“ klíč – práva omezuje RLS v databázi
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TAJNÉ: service_role / secret klíč – používá se jen na serveru pro uložení poptávek z formuláře
SUPABASE_SERVICE_ROLE_KEY=

# --- Web -------------------------------------------------------------
# veřejná adresa webu (kanonické URL, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.rybnickarestaurace.cz
# nepovinné: cesta k originálnímu logu v /public, pokud ho nechcete nahrávat přes administraci
# NEXT_PUBLIC_LOGO_PATH=/brand/logo.svg

# --- Resend (odesílání e-mailů) --------------------------------------
# TAJNÉ: API klíč z https://resend.com/api-keys (oprávnění „Sending access“)
RESEND_API_KEY=
# odesílatel z domény ověřené v Resend (Domains → Add domain)
EMAIL_FROM="Restaurace Rybníky <menu@rybnickarestaurace.cz>"

# --- Ostatní ---------------------------------------------------------
# TAJNÉ: libovolný náhodný řetězec pro anonymizaci IP adres (ochrana formuláře proti spamu)
IP_HASH_SALT=
