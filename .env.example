# HomeOS – konfigurace
# Zkopírujte do .env.local (lokálně) nebo nastavte v projektu na Vercelu.

# --- Supabase (produkční režim) --------------------------------------------
# Výchozí hodnoty (produkční projekt HomeOS) jsou přímo v src/lib/env.ts,
# tyto proměnné je jen přepisují – např. pro jiný projekt Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Veřejný „anon“ klíč – je bezpečný v prohlížeči, přístup hlídá Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Veřejná adresa aplikace (pro odkazy v potvrzovacích e-mailech), např. https://homeos.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Volitelné: AI (porozumění volným otázkám v asistentovi, odhad cen potravin) ---
# Bez klíče asistent funguje dál (deterministicky). Klíč je jen na serveru.
# ANTHROPIC_API_KEY=

# --- Volitelné: týdenní souhrn jako oznámení na telefon --------------------
# Klíče VAPID vygenerujete příkazem:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vas@email.cz
# Plánované odeslání (Vercel Cron, neděle 17:00 UTC) potřebuje service-role klíč
# Supabase – používá se VÝHRADNĚ v /api/cron/weekly na serveru, nikdy v prohlížeči.
# SUPABASE_SERVICE_ROLE_KEY=
# Náhodný dlouhý řetězec; Vercel ho posílá cronu v hlavičce Authorization.
# CRON_SECRET=

# --- Lokální režim (jen vývoj a testy) -------------------------------------
# Zapne ukládání do souboru místo Supabase. Na Vercelu se nikdy nepoužije.
# NEXT_PUBLIC_HOMEOS_LOCAL_MODE=1
# Složka pro data lokálního režimu (výchozí ./.data)
# HOMEOS_DATA_DIR=
# Tajný klíč pro podpis přihlašovacích cookies v lokálním režimu
# (výchozí: náhodně vygenerovaný a uložený v datovém souboru)
# LOCAL_SESSION_SECRET=

# --- Veřejný provoz: Premium, platby, administrace -------------------------
# Serverový klíč Supabase (Project Settings → API → service_role). Potřebuje ho
# administrace, webhook plateb, smazání účtu a plánované úlohy. NIKDY ho nedávejte do prohlížeče.
# SUPABASE_SERVICE_ROLE_KEY=
# Správci aplikace (čárkou oddělené e-maily). Výchozí: adamhorvath07@icloud.com
# ADMIN_EMAILS=
# Lemon Squeezy (Settings → API, Stores, Products → varianty, Webhooks)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_MONTHLY=
# LEMONSQUEEZY_VARIANT_YEARLY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Varianty se zkušební dobou 3 dny (v Lemon Squeezy u varianty zapněte Free trial: 3 days). Nepovinné.
# LEMONSQUEEZY_VARIANT_MONTHLY_TRIAL=
# LEMONSQUEEZY_VARIANT_YEARLY_TRIAL=
# Veřejná adresa aplikace (návrat z platby), např. https://homeos.cz
# APP_URL=
# Údaje provozovatele do podmínek a zásad
# OPERATOR_NAME=
# OPERATOR_ICO=
# OPERATOR_ADDRESS=
# OPERATOR_EMAIL=
